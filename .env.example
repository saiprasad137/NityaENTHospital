# =============================================================================
# Nitya ENT Hospital - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in the values for your local environment:
#   cp .env.example .env

# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Required for appointments, doctors, hospital events, achievements, and media
DATABASE_URL=postgresql://neondb_owner:npg_m8wndPx2RZXl@ep-jolly-sea-b5x0ub57-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clerk Authentication (Admin Portal)
# Optional for viewing the public hospital website.
# Required for signing in to the /admin control panel.
# Obtain from https://clerk.com
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
# CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
# CLERK_SECRET_KEY=sk_test_your_key_here
ADMIN_EMAILS=admin@nityaent.com

# Google Places API (Optional)
# If provided, fetches live Google reviews and ratings for the hospital
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# Storage Configuration
# Files are stored locally in the ./uploads folder by default.
LOCAL_UPLOAD_DIR=uploads

# Cloud Storage (Optional - for GCP deployments)
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
