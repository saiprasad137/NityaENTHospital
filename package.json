{
  "name": "nitya-ent-hospital-workspace",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/nitya-ent run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/nitya-ent run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:web": "pnpm --filter @workspace/nitya-ent run build",
    "start": "pnpm --filter @workspace/api-server run start",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:libs": "tsc --build",
    "db:push": "pnpm --filter @workspace/db run push",
    "codegen": "pnpm --filter @workspace/api-spec run codegen"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
